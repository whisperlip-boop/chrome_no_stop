{
  "manifest_version": 3,
  "name": "YouTube No Stop",
  "version": "1.0.0",
  "minimum_chrome_version": "111",
  "description": "Automatically confirms YouTube's 'Video paused. Continue watching?' dialog and resumes playback.",
  "icons": {
    "16": "icons/continue_16.png",
    "32": "icons/continue_32.png",
    "48": "icons/continue_48.png",
    "128": "icons/continue_128.png"
  },
  "permissions": ["storage"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {
      "16": "icons/continue_16.png",
      "32": "icons/continue_32.png"
    },
    "default_title": "YouTube No Stop"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://music.youtube.com/*"],
      "js": ["activity.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.youtube.com/*", "https://music.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
